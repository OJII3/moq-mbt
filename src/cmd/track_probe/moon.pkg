supported_targets = "native"

import {
  "OJII3/moq-mbt/protocol",
  "OJII3/moq-mbt/session",
  "OJII3/moq-mbt/transport",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "-lmsquic -lpthread" } },
)
